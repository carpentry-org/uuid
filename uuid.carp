(deftype UUID [internal (Array Byte)])
(derive UUID =)

(defmodule UUID
  (use-all Array Byte)

  (register xtob (Fn [String Int Int] Byte) "strtol")

  (def rfc4122 1)
  (def reserved 2)
  (def microsoft 3)
  (def future 4)

  (def indices [0 2 4 6 9 11 14 16 19 21 24 26 28 30 32 34])

  (defn str [uuid]
    (let [a (internal uuid)]
      (fmt
        "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x"
        @(unsafe-nth a 0)
        @(unsafe-nth a 1)
        @(unsafe-nth a 2)
        @(unsafe-nth a 3)
        @(unsafe-nth a 4)
        @(unsafe-nth a 5)
        @(unsafe-nth a 6)
        @(unsafe-nth a 7)
        @(unsafe-nth a 8)
        @(unsafe-nth a 9)
        @(unsafe-nth a 10)
        @(unsafe-nth a 11)
        @(unsafe-nth a 12)
        @(unsafe-nth a 13)
        @(unsafe-nth a 14)
        @(unsafe-nth a 15))))
  (implements str UUID.str)

  (doc hash "hashes a `UUID` so it can be used as a key in a `Map` or `Set`.

Hashes the 16 underlying bytes directly, so it allocates nothing.")
  (defn hash [uuid]
    (let-do [a (internal uuid)
             h 5381]
      (for [i 0 (length a)] (set! h (+ (* h 33) (to-int @(unsafe-nth a i)))))
      (Int.abs h)))
  (implements hash UUID.hash)

  (defn version [uuid] (bit-shift-right @(unsafe-nth (internal uuid) 6) 4b))

  (defn variant [uuid]
    (let [eighth @(unsafe-nth (internal uuid) 8)]
      (cond
        (= 128b (bit-and eighth 192b)) rfc4122
        (= 192b (bit-and eighth 224b)) microsoft
        (= 224b (bit-and eighth 224b)) future
        reserved)))

  (doc nil "returns the Nil UUID (RFC 9562 §5.9): all 128 bits set to zero,
`00000000-0000-0000-0000-000000000000`. It is commonly used as a null or
sentinel value where an absent UUID must still be represented.")
  (defn nil [] (init (replicate 16 &0b)))
  (implements zero UUID.nil)

  (doc max "returns the Max UUID (RFC 9562 §5.10): all 128 bits set to one,
`ffffffff-ffff-ffff-ffff-ffffffffffff`. It sorts after every other UUID under
[<](#<), which makes it a convenient upper sentinel.")
  (defn max [] (init (replicate 16 &255b)))

  (doc nil? "returns whether the UUID `uuid` is the [Nil UUID](#nil), i.e. every
one of its 16 bytes is zero.")
  (defn nil? [uuid]
    (let-do [a (internal uuid)
             res true]
      (for [i 0 16] (unless (Byte.= @(unsafe-nth a i) 0b) (set! res false)))
      res))

  (doc max? "returns whether the UUID `uuid` is the [Max UUID](#max), i.e. every
one of its 16 bytes is `0xff`.")
  (defn max? [uuid]
    (let-do [a (internal uuid)
             res true]
      (for [i 0 16] (unless (Byte.= @(unsafe-nth a i) 255b) (set! res false)))
      res))

  (private rfc-namespace)
  (hidden rfc-namespace)
  (defn rfc-namespace [b]
    (init
      [107b 167b 184b b 157b 173b 17b 209b 128b 180b 0b 192b 79b 212b 48b 200b]))

  (doc namespace-dns "returns the DNS namespace UUID
`6ba7b810-9dad-11d1-80b4-00c04fd430c8` (RFC 9562 §6.6), under which names are
fully qualified domain names.")
  (defn namespace-dns [] (rfc-namespace 16b))

  (doc namespace-url "returns the URL namespace UUID
`6ba7b811-9dad-11d1-80b4-00c04fd430c8` (RFC 9562 §6.6), under which names are
URLs.")
  (defn namespace-url [] (rfc-namespace 17b))

  (doc namespace-oid "returns the OID namespace UUID
`6ba7b812-9dad-11d1-80b4-00c04fd430c8` (RFC 9562 §6.6), under which names are
ISO object identifiers.")
  (defn namespace-oid [] (rfc-namespace 18b))

  (doc namespace-x500 "returns the X.500 namespace UUID
`6ba7b814-9dad-11d1-80b4-00c04fd430c8` (RFC 9562 §6.6), under which names are
X.500 distinguished names.")
  (defn namespace-x500 [] (rfc-namespace 20b))

  (doc < "compares two UUIDs as unsigned, big-endian 128-bit integers, i.e.
byte by byte from the most significant. For version-7 UUIDs this orders them
by creation time, so they sort chronologically.")
  (defn < [a b]
    (let-do [aa (internal a)
             ba (internal b)
             ord 0]
      (for [i 0 16]
        (when (Int.= ord 0)
          (let [x @(unsafe-nth aa i)
                y @(unsafe-nth ba i)]
            (cond (Byte.< x y) (set! ord -1) (Byte.< y x) (set! ord 1) ()))))
      (Int.= ord -1)))
  (implements < UUID.<)

  (doc > "checks whether the UUID `a` sorts after `b` under [<](#<).")
  (defn > [a b] (< b a))
  (implements > UUID.>)

  (doc <= "checks whether the UUID `a` sorts at or before `b` under [<](#<).")
  (defn <= [a b] (not (< b a)))

  (doc >= "checks whether the UUID `a` sorts at or after `b` under [<](#<).")
  (defn >= [a b] (not (< a b)))

  (defn valid? [s]
    (and (= (String.length s) 36)
         (Pattern.matches?
           #"\x\x\x\x\x\x\x\x\-\x\x\x\x\-\x\x\x\x\-\x\x\x\x\-\x\x\x\x\x\x\x\x\x\x\x\x"
           s)))

  (private indices)
  (hidden indices)

  (doc parse "parses a string into a `UUID`; returns nothing if it fails.")
  (defn parse [s]
    (if (valid? s)
      (let-do [a (replicate 16 &0b)]
        (for [i 0 (length &indices)]
          (aset! &a
                 i
                 (xtob
                   (slice s
                          @(unsafe-nth &indices i)
                          (+ @(unsafe-nth &indices i) 2))
                   0
                   16)))
        (Maybe.Just (UUID.init a)))
      (Maybe.Nothing))))

(defmodule UUIDCopy
  (defn = [a b] (UUID.= &a &b))
  (implements = UUIDCopy.=))

(defmodule UUID4
  (use-all Array Byte)
  (defn generate []
    (let-do [a (repeat 16 &random)]
      (aset! &a 6 (bit-or (bit-and @(unsafe-nth &a 6) 15b) 64b))
      (aset! &a 8 (bit-or (bit-and @(unsafe-nth &a 8) 63b) 128b))
      (UUID.init a))))

(defmodule UUID1
  (use-all Array Int Byte)

  (def clock-seq 0)

  ; `Uint64.to-long` narrows through C `long`, so the 60-bit timestamp stays in
  ; `Uint64` (what `System.nanotime` returns); only bytes cross into `Int`.
  (def slast (Uint64.zero))

  ; ticks the last emitted timestamp sits ahead of `slast`.
  (def adjustment 0)
  (private adjustment)
  (hidden adjustment)

  ; the most `adjustment` may reach before the generator waits for the clock.
  (def max-adjustment 9)
  (private max-adjustment)
  (hidden max-adjustment)

  (private byte-at)
  (hidden byte-at)
  (defn byte-at [n shift]
    (Byte.from-int
      (Long.to-int
        (Uint64.to-long
          (Uint64.bit-and
            (Uint64.bit-shift-right n (Uint64.from-long (Long.from-int shift)))
            (Uint64.from-long 255l))))))

  ; 100-nanosecond intervals from 1582-10-15 00:00:00 UTC to the Unix epoch.
  (private gregorian-offset)
  (hidden gregorian-offset)
  (defn gregorian-offset []
    (Uint64.* (Uint64.from-long 122192928l) (Uint64.from-long 1000000000l)))

  (defn set-clock-seq [seq]
    (do
      (when (= seq -1)
        (set! seq
              (bit-or
                (bit-shift-left (to-int (Byte.random)) 8)
                (to-int (Byte.random)))))
      (let-do [old clock-seq]
        (set! clock-seq (bit-or (bit-and seq 16383) 32768))
        (when-do (/= old clock-seq)
          (set! slast (Uint64.zero))
          (set! adjustment 0)))))

  (private read-clock)
  (hidden read-clock)
  (defn read-clock []
    (Uint64.+
      (Uint64./ (System.nanotime) (Uint64.from-long 100l))
      (gregorian-offset)))

  (private emitted)
  (hidden emitted)
  (defn emitted []
    (Uint64.+ slast (Uint64.from-long (Long.from-int adjustment))))

  ; folds a clock reading into the state. False, and the state untouched, when
  ; that would put the timestamp more than `max-adjustment` ticks ahead of it.
  (private advance)
  (hidden advance)
  (defn advance [now]
    (cond
      (Uint64.< now slast)
        (do
          (set! clock-seq (bit-or (bit-and (inc clock-seq) 16383) 32768))
          (set! slast now)
          (set! adjustment 0)
          true)
      (Uint64.> now (emitted)) (do (set! slast now) (set! adjustment 0) true)
      (let [ahead (inc (Long.to-int (Uint64.to-long (Uint64.- (emitted) now))))]
        (if (> ahead max-adjustment)
          false
          (do (set! slast now) (set! adjustment ahead) true)))))

  (doc get-time "returns the current time as RFC 9562 §5.1 defines it for
versions 1 and 6: a 60-bit count of 100-nanosecond intervals since
1582-10-15 00:00:00 UTC.

The result is strictly increasing. Calls landing inside one 100-nanosecond tick
each advance it by a tick, up to nine ticks ahead of the clock, after which the
generator waits for the clock to catch up. The clock sequence is bumped only
when the clock actually steps backwards.")
  (defn get-time []
    (do
      (when (= clock-seq 0) (set-clock-seq -1))
      (let-do [reading (read-clock)]
        (while (not (advance reading)) (set! reading (read-clock)))
        (emitted))))

  ; TODO: actually get hardware interfaces (we’re only adhering to 4.5 here,
  ; generating random values)
  (defn generate []
    (let-do [t (get-time)
             a (allocate 16)]
      (aset! &a 0 (byte-at t 24))
      (aset! &a 1 (byte-at t 16))
      (aset! &a 2 (byte-at t 8))
      (aset! &a 3 (byte-at t 0))
      (aset! &a 4 (byte-at t 40))
      (aset! &a 5 (byte-at t 32))
      (aset! &a 6 (bit-or (bit-and (byte-at t 56) 15b) 16b))
      (aset! &a 7 (byte-at t 48))
      (aset! &a 8 (from-int (bit-and (bit-shift-right clock-seq 8) 255)))
      (aset! &a 9 (from-int (bit-and clock-seq 255)))
      (for [i 0 6] (aset! &a (+ 10 i) (random)))
      (aset! &a 10 (bit-or @(unsafe-nth &a 10) 1b))
      (UUID.init a)))

  (doc timestamp "extracts the 60-bit timestamp of a version-1 UUID as a
`Uint64`: 100-nanosecond intervals since 1582-10-15 00:00:00 UTC, with the
version nibble stripped. [to-nanotime](#to-nanotime) puts it back on the Unix
scale `System.nanotime` uses.")
  (defn timestamp [uuid]
    (let-do [a (UUID.internal uuid)
             order [7 4 5 0 1 2 3]
             ts (Uint64.from-long
               (Long.from-int (to-int (bit-and @(unsafe-nth a 6) 15b))))]
      (for [i 0 7]
        (set! ts
              (Uint64.bit-or
                (Uint64.bit-shift-left ts (Uint64.from-long 8l))
                (Uint64.from-long
                  (Long.from-int (to-int @(unsafe-nth a @(unsafe-nth &order i))))))))
      ts))

  ; the last timestamp whose Unix-epoch nanoseconds still fit in a `Uint64`.
  (private max-nanotime)
  (hidden max-nanotime)
  (defn max-nanotime []
    (Uint64.+ (gregorian-offset) (Uint64./ Uint64.MAX (Uint64.from-long 100l))))

  (doc to-nanotime "converts a version-1 or version-6 [timestamp](#timestamp)
into nanoseconds since the Unix epoch, the scale `System.nanotime` uses.

Version-1 timestamps run from 1582 to 5236, so the conversion is a `Maybe`: it
is `Nothing` outside 1970 to 2554-07-21, the range that scale covers.")
  (defn to-nanotime [ts]
    (if (or (Uint64.< ts (gregorian-offset)) (Uint64.> ts (max-nanotime)))
      (Maybe.Nothing)
      (Maybe.Just
        (Uint64.* (Uint64.- ts (gregorian-offset)) (Uint64.from-long 100l))))))

(defmodule UUID6
  (use-all Array Byte)

  ; laying the timestamp out the other way round moves every one of its bytes
  ; half a byte along, so each is two nibbles of two neighbouring source bytes.
  (private shifted)
  (hidden shifted)
  (defn shifted [a hi lo]
    (bit-or
      (bit-shift-left (bit-and @(unsafe-nth a hi) 15b) 4b)
      (bit-shift-right @(unsafe-nth a lo) 4b)))

  (doc from-v1 "converts a version-1 UUID into the version-6 UUID carrying the
same timestamp, clock sequence and node (RFC 9562 §5.6), which is how existing
version-1 identifiers are migrated to a sortable layout.

```
(UUID.str &(UUID6.from-v1 &v1))
; c232ab00-9414-11ec-b3c8-9f6bdeced846 => 1ec9414c-232a-6b00-b3c8-9f6bdeced846
```")
  (defn from-v1 [uuid]
    (let-do [a (UUID.internal uuid)
             out @a]
      (aset! &out 0 (shifted a 6 7))
      (aset! &out 1 (shifted a 7 4))
      (aset! &out 2 (shifted a 4 5))
      (aset! &out 3 (shifted a 5 0))
      (aset! &out 4 (shifted a 0 1))
      (aset! &out 5 (shifted a 1 2))
      (aset! &out 6 (bit-or (bit-and @(unsafe-nth a 2) 15b) 96b))
      (aset! &out 7 @(unsafe-nth a 3))
      (UUID.init out)))

  (doc to-v1 "converts a version-6 UUID back into the version-1 UUID carrying
the same timestamp, clock sequence and node, the inverse of
[from-v1](#from-v1).")
  (defn to-v1 [uuid]
    (let-do [a (UUID.internal uuid)
             out @a]
      (aset! &out 0 (shifted a 3 4))
      (aset! &out 1 (shifted a 4 5))
      (aset! &out
             2
             (bit-or
               (bit-shift-left (bit-and @(unsafe-nth a 5) 15b) 4b)
               (bit-and @(unsafe-nth a 6) 15b)))
      (aset! &out 3 @(unsafe-nth a 7))
      (aset! &out 4 (shifted a 1 2))
      (aset! &out 5 (shifted a 2 3))
      (aset! &out 6 (bit-or (bit-shift-right @(unsafe-nth a 0) 4b) 16b))
      (aset! &out 7 (shifted a 0 1))
      (UUID.init out)))

  (doc generate "generates a new version-6 UUID (RFC 9562 §5.6): the same
60-bit timestamp, clock sequence and node as `UUID1.generate`, with the
timestamp laid out most significant bits first. Successive UUIDs therefore
compare in creation order under `UUID.<`, which is what version 6 is for and
what version 1 cannot do.")
  (defn generate [] (from-v1 &(UUID1.generate)))

  (doc timestamp "extracts the 60-bit timestamp of a version-6 UUID as a
`Uint64`: 100-nanosecond intervals since 1582-10-15 00:00:00 UTC, with the
version nibble stripped. `UUID1.to-nanotime` puts it back on the Unix scale
`System.nanotime` uses.")
  (defn timestamp [uuid] (UUID1.timestamp &(to-v1 uuid))))

(defmodule UUID7
  (use-all Array Byte)

  ; `Uint64.to-long` narrows through C `long`, so the 48-bit timestamp stays in
  ; `Uint64` (what `System.nanotime` returns); only bytes cross into `Int`.
  (def last-ms (Uint64.zero))
  (private last-ms)
  (hidden last-ms)

  (def counter 0)
  (private counter)
  (hidden counter)

  ; an 11-bit random counter seed; the 12th counter bit is kept clear so there
  ; is room to increment within a millisecond before the counter overflows.
  (private next-seed)
  (hidden next-seed)
  (defn next-seed []
    (Int.bit-and
      (Int.bit-or
        (Int.bit-shift-left (to-int (Byte.random)) 8)
        (to-int (Byte.random)))
      2047))

  ; the byte at bit offset `shift` of the `Uint64` `n`. `shift` is a small `Int`,
  ; so the masked value is in [0, 255] and survives the conversion through `Long`.
  (private byte-at)
  (hidden byte-at)
  (defn byte-at [n shift]
    (Byte.from-int
      (Long.to-int
        (Uint64.to-long
          (Uint64.bit-and
            (Uint64.bit-shift-right n (Uint64.from-long (Long.from-int shift)))
            (Uint64.from-long 255l))))))

  (doc generate "generates a new version-7 UUID (RFC 9562): a 48-bit Unix
millisecond timestamp, a 12-bit monotonic counter, and 62 random bits.
Successive UUIDs always compare in creation order under `UUID.<`, even when
generated within the same millisecond.")
  (defn generate []
    (let-do [now (Uint64./ (System.nanotime) (Uint64.from-long 1000000l))]
      (if (Uint64.> now last-ms)
        (do (set! last-ms now) (set! counter (next-seed)))
        (do
          (set! counter (Int.inc counter))
          (when-do (Int.> counter 4095)
            (set! last-ms (Uint64.+ last-ms (Uint64.from-long 1l)))
            (set! counter (next-seed)))))
      (let-do [a (repeat 16 &random)]
        (for [i 0 6] (aset! &a i (byte-at last-ms (Int.* 8 (Int.- 5 i)))))
        (aset! &a
               6
               (Byte.from-int
                 (Int.bit-or 112
                             (Int.bit-and (Int.bit-shift-right counter 8) 15))))
        (aset! &a 7 (Byte.from-int (Int.bit-and counter 255)))
        (aset! &a
               8
               (Byte.from-int
                 (Int.bit-or 128 (Int.bit-and (to-int (Byte.random)) 63))))
        (UUID.init a))))

  (doc timestamp "extracts the 48-bit Unix millisecond timestamp from a
version-7 UUID, as a `Uint64`.")
  (defn timestamp [uuid]
    (let-do [a (UUID.internal uuid)
             ms (Uint64.zero)]
      (for [i 0 6]
        (set! ms
              (Uint64.bit-or
                (Uint64.bit-shift-left ms (Uint64.from-long 8l))
                (Uint64.from-long (Long.from-int (to-int @(unsafe-nth a i)))))))
      ms)))

(defmodule UUID5
  (use Array)

  (private of-int)
  (hidden of-int)
  (defn of-int [x] (Uint32.from-long (Long.from-int x)))

  (private u32)
  (hidden u32)
  (defn u32 [hi lo]
    (Uint32.bit-or
      (Uint32.bit-shift-left (Uint32.from-long hi) (of-int 16))
      (Uint32.from-long lo)))

  (private rotl)
  (hidden rotl)
  (defn rotl [x n]
    (Uint32.bit-or (Uint32.bit-shift-left x (of-int n))
                   (Uint32.bit-shift-right x (of-int (- 32 n)))))

  (private byte-at32)
  (hidden byte-at32)
  (defn byte-at32 [x shift]
    (Byte.from-int
      (Long.to-int
        (Uint32.to-long
          (Uint32.bit-and (Uint32.bit-shift-right x (of-int shift)) (of-int 255))))))

  (private byte-at64)
  (hidden byte-at64)
  (defn byte-at64 [x shift]
    (Byte.from-int
      (Long.to-int
        (Uint64.to-long
          (Uint64.bit-and
            (Uint64.bit-shift-right x (Uint64.from-long (Long.from-int shift)))
            (Uint64.from-long 255l))))))

  (private u8)
  (hidden u8)
  (defn u8 [buf i] (of-int (Byte.to-int @(unsafe-nth buf i))))

  (private word-at)
  (hidden word-at)
  (defn word-at [buf i]
    (Uint32.bit-or
      (Uint32.bit-or
        (Uint32.bit-shift-left (u8 buf i) (of-int 24))
        (Uint32.bit-shift-left (u8 buf (+ i 1)) (of-int 16)))
      (Uint32.bit-or
        (Uint32.bit-shift-left (u8 buf (+ i 2)) (of-int 8))
        (u8 buf (+ i 3)))))

  ; initial state: 0x67452301 0xefcdab89 0x98badcfe 0x10325476 0xc3d2e1f0
  (private initial-state)
  (hidden initial-state)
  (defn initial-state []
    [(u32 26437l 8961l)
     (u32 61389l 43913l)
     (u32 39098l 56574l)
     (u32 4146l 21622l)
     (u32 50130l 57840l)])

  ; round constants: 0x5a827999 0x6ed9eba1 0x8f1bbcdc 0xca62c1d6
  (private round-constant)
  (hidden round-constant)
  (defn round-constant [j]
    (cond
      (< j 20) (u32 23170l 31129l)
      (< j 40) (u32 28377l 60321l)
      (< j 60) (u32 36635l 48348l)
      (u32 51810l 49622l)))

  ; the message, a 1 bit, zeroes, and the 64-bit big-endian bit length.
  (private padded)
  (hidden padded)
  (defn padded [data]
    (let-do [len (length data)
             total (let [r (Int.mod (+ len 9) 64)]
               (+ (+ len 9) (if (= r 0) 0 (- 64 r))))
             buf (replicate total &0b)
             bits (Uint64.* (Uint64.from-long (Long.from-int len))
                            (Uint64.from-long 8l))]
      (for [i 0 len] (aset! &buf i @(unsafe-nth data i)))
      (aset! &buf len 128b)
      (for [i 0 8] (aset! &buf (+ (- total 8) i) (byte-at64 bits (* (- 7 i) 8))))
      buf))

  (private compress)
  (hidden compress)
  (defn compress [h buf off]
    (let-do [w (replicate 80 &(Uint32.zero))
             a @(unsafe-nth h 0)
             b @(unsafe-nth h 1)
             c @(unsafe-nth h 2)
             d @(unsafe-nth h 3)
             e @(unsafe-nth h 4)]
      (for [j 0 16] (aset! &w j (word-at buf (+ off (* j 4)))))
      (for [j 16 80]
        (aset! &w
               j
               (rotl
                 (Uint32.bit-xor
                   (Uint32.bit-xor @(unsafe-nth &w (- j 3))
                                   @(unsafe-nth &w (- j 8)))
                   (Uint32.bit-xor @(unsafe-nth &w (- j 14))
                                   @(unsafe-nth &w (- j 16))))
                 1)))
      (for [j 0 80]
        (let-do [f (cond
                   (< j 20)
                     (Uint32.bit-or (Uint32.bit-and b c)
                                    (Uint32.bit-and (Uint32.bit-not b) d))
                   (< j 40) (Uint32.bit-xor b (Uint32.bit-xor c d))
                   (< j 60)
                     (Uint32.bit-or
                       (Uint32.bit-or (Uint32.bit-and b c) (Uint32.bit-and b d))
                       (Uint32.bit-and c d))
                   (Uint32.bit-xor b (Uint32.bit-xor c d)))
                 k (round-constant j)
                 tmp (Uint32.+
                   (Uint32.+ (Uint32.+ (Uint32.+ (rotl a 5) f) e) k)
                   @(unsafe-nth &w j))]
          (set! e d)
          (set! d c)
          (set! c (rotl b 30))
          (set! b a)
          (set! a tmp)))
      [(Uint32.+ @(unsafe-nth h 0) a)
       (Uint32.+ @(unsafe-nth h 1) b)
       (Uint32.+ @(unsafe-nth h 2) c)
       (Uint32.+ @(unsafe-nth h 3) d)
       (Uint32.+ @(unsafe-nth h 4) e)]))

  (private digest)
  (hidden digest)
  (defn digest [data]
    (let-do [buf (padded data)
             h (initial-state)
             out (replicate 20 &0b)]
      (for [blk 0 (/ (length &buf) 64)]
        (let-do [next (compress &h &buf (* blk 64))] (set! h next)))
      (for [i 0 5]
        (for [j 0 4]
          (aset! &out (+ (* i 4) j) (byte-at32 @(unsafe-nth &h i) (* (- 3 j) 8)))))
      out))

  (doc generate "generates a version-5 UUID (RFC 9562 §5.5): the SHA-1 hash of
the `namespace` UUID followed by the UTF-8 bytes of `name`, truncated to 128
bits, with the version and variant bits set.

The same namespace and name always yield the same UUID, which makes version 5
the right choice for identifiers derived from content. The predefined
namespaces of RFC 9562 §6.6 are [UUID.namespace-dns](#namespace-dns),
[UUID.namespace-url](#namespace-url), [UUID.namespace-oid](#namespace-oid) and
[UUID.namespace-x500](#namespace-x500), but any UUID will do.

```
(UUID.str &(UUID5.generate &(UUID.namespace-dns) \"www.example.com\"))
; => 2ed6657d-e927-568b-95e1-2665a8aea6a2
```")
  (defn generate [namespace name]
    (let-do [data (concat &[@(UUID.internal namespace) (String.to-bytes name)])
             a (prefix &(digest &data) 16)]
      (aset! &a 6 (Byte.bit-or (Byte.bit-and @(unsafe-nth &a 6) 15b) 80b))
      (aset! &a 8 (Byte.bit-or (Byte.bit-and @(unsafe-nth &a 8) 63b) 128b))
      (UUID.init a))))

(defmodule UUID3
  (use Array)

  (private of-int)
  (hidden of-int)
  (defn of-int [x] (Uint32.from-long (Long.from-int x)))

  (private u32)
  (hidden u32)
  (defn u32 [hi lo]
    (Uint32.bit-or
      (Uint32.bit-shift-left (Uint32.from-long hi) (of-int 16))
      (Uint32.from-long lo)))

  (private rotl)
  (hidden rotl)
  (defn rotl [x n]
    (Uint32.bit-or (Uint32.bit-shift-left x (of-int n))
                   (Uint32.bit-shift-right x (of-int (- 32 n)))))

  (private byte-at32)
  (hidden byte-at32)
  (defn byte-at32 [x shift]
    (Byte.from-int
      (Long.to-int
        (Uint32.to-long
          (Uint32.bit-and (Uint32.bit-shift-right x (of-int shift)) (of-int 255))))))

  (private byte-at64)
  (hidden byte-at64)
  (defn byte-at64 [x shift]
    (Byte.from-int
      (Long.to-int
        (Uint64.to-long
          (Uint64.bit-and
            (Uint64.bit-shift-right x (Uint64.from-long (Long.from-int shift)))
            (Uint64.from-long 255l))))))

  (private u8)
  (hidden u8)
  (defn u8 [buf i] (of-int (Byte.to-int @(unsafe-nth buf i))))

  (private word-at)
  (hidden word-at)
  (defn word-at [buf i]
    (Uint32.bit-or
      (Uint32.bit-or (u8 buf i)
                     (Uint32.bit-shift-left (u8 buf (+ i 1)) (of-int 8)))
      (Uint32.bit-or
        (Uint32.bit-shift-left (u8 buf (+ i 2)) (of-int 16))
        (Uint32.bit-shift-left (u8 buf (+ i 3)) (of-int 24)))))

  ; initial state: 0x67452301 0xefcdab89 0x98badcfe 0x10325476
  (private initial-state)
  (hidden initial-state)
  (defn initial-state []
    [(u32 26437l 8961l)
     (u32 61389l 43913l)
     (u32 39098l 56574l)
     (u32 4146l 21622l)])

  ; the per-round constants K[i] = floor(2^32 * abs(sin(i + 1))), RFC 1321 §3.4.
  (def sines
    [(u32 55146l 42104l)
     (u32 59591l 46934l)
     (u32 9248l 28891l)
     (u32 49597l 52974l)
     (u32 62844l 4015l)
     (u32 18311l 50730l)
     (u32 43056l 17939l)
     (u32 64838l 38145l)
     (u32 27008l 39128l)
     (u32 35652l 63407l)
     (u32 65535l 23473l)
     (u32 35164l 55230l)
     (u32 27536l 4386l)
     (u32 64920l 29075l)
     (u32 42617l 17294l)
     (u32 18868l 2081l)
     (u32 63006l 9570l)
     (u32 49216l 45888l)
     (u32 9822l 23121l)
     (u32 59830l 51114l)
     (u32 54831l 4189l)
     (u32 580l 5203l)
     (u32 55457l 59009l)
     (u32 59347l 64456l)
     (u32 8673l 52710l)
     (u32 49975l 2006l)
     (u32 62677l 3463l)
     (u32 17754l 5357l)
     (u32 43491l 59653l)
     (u32 64751l 41976l)
     (u32 26479l 729l)
     (u32 36138l 19594l)
     (u32 65530l 14658l)
     (u32 34673l 63105l)
     (u32 28061l 24866l)
     (u32 64997l 14348l)
     (u32 42174l 59972l)
     (u32 19422l 53161l)
     (u32 63163l 19296l)
     (u32 48831l 48240l)
     (u32 10395l 32454l)
     (u32 60065l 10234l)
     (u32 54511l 12421l)
     (u32 1160l 7429l)
     (u32 55764l 53305l)
     (u32 59099l 39397l)
     (u32 8098l 31992l)
     (u32 50348l 22117l)
     (u32 62505l 8772l)
     (u32 17194l 65431l)
     (u32 43924l 9127l)
     (u32 64659l 41017l)
     (u32 25947l 22979l)
     (u32 36620l 52370l)
     (u32 65519l 62589l)
     (u32 34180l 24017l)
     (u32 28584l 32335l)
     (u32 65068l 59104l)
     (u32 41729l 17172l)
     (u32 19976l 4513l)
     (u32 63315l 32386l)
     (u32 48442l 62005l)
     (u32 10967l 53947l)
     (u32 60294l 54161l)])
  (private sines)
  (hidden sines)

  ; the four left-rotate amounts of each of the four round groups.
  (def shifts [7 12 17 22 5 9 14 20 4 11 16 23 6 10 15 21])
  (private shifts)
  (hidden shifts)

  ; the message, a 1 bit, zeroes, and the 64-bit little-endian bit length.
  (private padded)
  (hidden padded)
  (defn padded [data]
    (let-do [len (length data)
             total (let [r (Int.mod (+ len 9) 64)]
               (+ (+ len 9) (if (= r 0) 0 (- 64 r))))
             buf (replicate total &0b)
             bits (Uint64.* (Uint64.from-long (Long.from-int len))
                            (Uint64.from-long 8l))]
      (for [i 0 len] (aset! &buf i @(unsafe-nth data i)))
      (aset! &buf len 128b)
      (for [i 0 8] (aset! &buf (+ (- total 8) i) (byte-at64 bits (* i 8))))
      buf))

  (private compress)
  (hidden compress)
  (defn compress [h buf off]
    (let-do [a @(unsafe-nth h 0)
             b @(unsafe-nth h 1)
             c @(unsafe-nth h 2)
             d @(unsafe-nth h 3)]
      (for [j 0 64]
        (let-do [f (cond
                   (< j 16)
                     (Uint32.bit-or (Uint32.bit-and b c)
                                    (Uint32.bit-and (Uint32.bit-not b) d))
                   (< j 32)
                     (Uint32.bit-or (Uint32.bit-and d b)
                                    (Uint32.bit-and (Uint32.bit-not d) c))
                   (< j 48) (Uint32.bit-xor b (Uint32.bit-xor c d))
                   (Uint32.bit-xor c (Uint32.bit-or b (Uint32.bit-not d))))
                 g (cond
                   (< j 16) j
                   (< j 32) (Int.mod (+ (* 5 j) 1) 16)
                   (< j 48) (Int.mod (+ (* 3 j) 5) 16)
                   (Int.mod (* 7 j) 16))
                 s @(unsafe-nth &shifts (+ (* 4 (/ j 16)) (Int.mod j 4)))
                 tmp (Uint32.+
                   (Uint32.+ (Uint32.+ a f) @(unsafe-nth &sines j))
                   (word-at buf (+ off (* g 4))))]
          (set! a d)
          (set! d c)
          (set! c b)
          (set! b (Uint32.+ b (rotl tmp s)))))
      [(Uint32.+ @(unsafe-nth h 0) a)
       (Uint32.+ @(unsafe-nth h 1) b)
       (Uint32.+ @(unsafe-nth h 2) c)
       (Uint32.+ @(unsafe-nth h 3) d)]))

  (private digest)
  (hidden digest)
  (defn digest [data]
    (let-do [buf (padded data)
             h (initial-state)
             out (replicate 16 &0b)]
      (for [blk 0 (/ (length &buf) 64)]
        (let-do [next (compress &h &buf (* blk 64))] (set! h next)))
      (for [i 0 4]
        (for [j 0 4]
          (aset! &out (+ (* i 4) j) (byte-at32 @(unsafe-nth &h i) (* j 8)))))
      out))

  (doc generate "generates a version-3 UUID (RFC 9562 §5.3): the MD5 hash of
the `namespace` UUID followed by the UTF-8 bytes of `name`, truncated to 128
bits, with the version and variant bits set.

Version 3 is specified over MD5, which is no longer considered secure; it
exists to interoperate with names already registered under an existing
version-3 namespace. `UUID5.generate` and `UUID7.generate` are the better
choice for new work.

The predefined namespaces of RFC 9562 §6.6 are
[UUID.namespace-dns](#namespace-dns), [UUID.namespace-url](#namespace-url),
[UUID.namespace-oid](#namespace-oid) and
[UUID.namespace-x500](#namespace-x500), but any UUID will do.

```
(UUID.str &(UUID3.generate &(UUID.namespace-dns) \"www.example.com\"))
; => 5df41881-3aed-3515-88a7-2f4a814cf09e
```")
  (defn generate [namespace name]
    (let-do [data (concat &[@(UUID.internal namespace) (String.to-bytes name)])
             a (digest &data)]
      (aset! &a 6 (Byte.bit-or (Byte.bit-and @(unsafe-nth &a 6) 15b) 48b))
      (aset! &a 8 (Byte.bit-or (Byte.bit-and @(unsafe-nth &a 8) 63b) 128b))
      (UUID.init a))))
