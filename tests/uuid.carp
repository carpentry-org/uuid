(load "uuid.carp")

(load "Test.carp")

(use-all Test UUID)

; generate two v7 UUIDs in sequence and check they sort in creation order. The
; binding order matters, so this cannot be inlined as two argument expressions.
(defn v7-monotonic? []
  (let-do [u1 (UUID7.generate)
           u2 (UUID7.generate)] (UUID.< &u1 &u2)))

; the timestamp read back out of a fresh v7 UUID should be within ~2s of now.
; the comparison avoids Uint64 underflow by subtracting in the larger direction.
(defn v7-timestamp-close? []
  (let-do [u (UUID7.generate)
           ts (UUID7.timestamp &u)
           now (Uint64./ (System.nanotime) (Uint64.from-long 1000000l))]
    (if (Uint64.> now ts)
      (Uint64.< (Uint64.- now ts) (Uint64.from-long 2000l))
      (Uint64.< (Uint64.- ts now) (Uint64.from-long 2000l)))))

; a UUID must be usable as a Map key, which requires a hash implementation.
(defn uuid-map-roundtrip? []
  (let [u (init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b])
        m (Map.put (Map.create) &u &42)]
    (= &(Maybe.Just 42) &(Map.get-maybe &m &u))))

; the Max UUID with only its final byte cleared, so max? must inspect every
; byte rather than short-circuiting before the end.
(defn almost-max []
  (let-do [a @(UUID.internal &(UUID.max))] (Array.aset! &a 15 0b) (UUID.init a)))

; an arbitrary UUID that sits strictly between the Nil and Max extremes.
(defn sample []
  (UUID.init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))

; random-node v1 UUIDs set the multicast bit: LSB of byte 10 (RFC 4122 §4.5)
(defn v1-multicast-bit-set? []
  (let [u (UUID1.generate)
        a (UUID.internal &u)]
    (Byte.= 1b (Byte.bit-and @(Array.unsafe-nth a 10) 1b))))

; version nibble (high 4 bits of byte 6) is 1 for v1
(defn v1-version-nibble? []
  (let [u (UUID1.generate)
        a (UUID.internal &u)]
    (Byte.= 1b (Byte.bit-shift-right @(Array.unsafe-nth a 6) 4b))))

; variant bits (top 2 bits of byte 8) are 10 for RFC 4122
(defn v1-variant-bits? []
  (let [u (UUID1.generate)
        a (UUID.internal &u)]
    (Byte.= 128b (Byte.bit-and @(Array.unsafe-nth a 8) 192b))))

(defn mask60 []
  (Uint64.-
    (Uint64.bit-shift-left (Uint64.from-long 1l) (Uint64.from-long 60l))
    (Uint64.from-long 1l)))

; the 60-bit timestamp of a v1 UUID, i.e. time_low, time_mid and
; time_hi_and_version with the version nibble masked off.
(defn v1-timestamp [u]
  (let-do [a (UUID.internal u)
           order [6 7 4 5 0 1 2 3]
           ts (Uint64.zero)]
    (for [i 0 8]
      (set! ts
            (Uint64.bit-or
              (Uint64.bit-shift-left ts (Uint64.from-long 8l))
              (Uint64.from-long
                (Long.from-int
                  (Byte.to-int
                    @(Array.unsafe-nth a @(Array.unsafe-nth &order i))))))))
    (Uint64.bit-and ts (mask60))))

; the timestamp of a fresh v1 UUID should be within a second of the clock. The
; difference is taken modulo 2^60 so a rollover cannot flake the comparison.
(defn v1-timestamp-tracks-clock? []
  (let [u (UUID1.generate)
        ts (v1-timestamp &u)
        now (Uint64.bit-and (System.nanotime) (mask60))]
    (Uint64.<
      (Uint64.bit-and (Uint64.- now ts) (mask60))
      (Uint64.from-long 1000000000l))))

(defn clock-above-32-bits []
  (Uint64.bit-shift-right
    (Uint64.bit-and (System.nanotime) (mask60))
    (Uint64.from-long 32l)))

; time_mid and time_hi must hold bits 32-59 of the clock. Reading those bits on
; both sides of the call covers a carry into bit 32 landing mid-test.
(defn v1-high-bits-match-clock? []
  (let [before (clock-above-32-bits)
        u (UUID1.generate)
        after (clock-above-32-bits)
        high (Uint64.bit-shift-right (v1-timestamp &u) (Uint64.from-long 32l))]
    (or (Uint64.= high before) (Uint64.= high after))))

; a v5 UUID over a name of `n` `x`es. With the 16-byte namespace prepended this
; puts the SHA-1 input at 16+n bytes, pinning the padding boundaries.
(defn v5-x [n]
  (UUID.str &(UUID5.generate &(UUID.namespace-dns) &(String.repeat n "x"))))

(defn v5-deterministic? []
  (UUID.=
    &(UUID5.generate &(UUID.namespace-url) "https://carp-lang.org/")
    &(UUID5.generate &(UUID.namespace-url) "https://carp-lang.org/")))

(defn v5-name-sensitive? []
  (UUID./=
    &(UUID5.generate &(UUID.namespace-dns) "a")
    &(UUID5.generate &(UUID.namespace-dns) "b")))

(defn v5-namespace-sensitive? []
  (UUID./=
    &(UUID5.generate &(UUID.namespace-dns) "www.example.com")
    &(UUID5.generate &(UUID.namespace-url) "www.example.com")))

(deftest test
  (assert-equal test
    "00010203-0405-0607-0809-0a0b0c0d0e0f"
    &(str &(init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    "stringification works")
  (assert-equal test 4b (version &(UUID4.generate)) "UUID4.generate works I")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID4.generate))
    "UUID4.generate works II")
  (assert-equal test 1b (version &(UUID1.generate)) "UUID1.generate works I")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID1.generate))
    "UUID1.generate works II")
  (assert-true test
    (v1-multicast-bit-set?)
    "UUID1.generate sets the RFC 4122 multicast bit on the node")
  (assert-true test
    (v1-version-nibble?)
    "UUID1.generate sets version 1 in the byte-6 nibble")
  (assert-true test
    (v1-variant-bits?)
    "UUID1.generate sets the RFC 4122 variant bits in byte 8")
  (assert-true test
    (v1-timestamp-tracks-clock?)
    "UUID1.generate stamps the current time into the timestamp fields")
  (assert-true test
    (v1-high-bits-match-clock?)
    "UUID1.generate fills time_mid and time_hi from the clock")
  (assert-equal test
    &(Maybe.Just (init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    &(parse "00010203-0405-0607-0809-0a0b0c0d0e0f")
    "parsing works I")
  (assert-equal test &(Maybe.Nothing) &(parse "invalid hex") "parsing works II")
  (assert-false test
    (valid? "prefix00000000-0000-0000-0000-000000000000")
    "prefixed UUID is rejected")
  (assert-false test
    (valid? "00000000-0000-0000-0000-000000000000suffix")
    "suffixed UUID is rejected")
  (assert-equal test
    7b
    (version &(UUID7.generate))
    "UUID7.generate sets version 7")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID7.generate))
    "UUID7.generate sets the RFC 4122 variant")
  (assert-true test
    (valid? &(str &(UUID7.generate)))
    "UUID7.generate produces a structurally valid UUID")
  (assert-true test
    (v7-monotonic?)
    "successive UUID7.generate results are strictly ordered")
  (assert-true test
    (v7-timestamp-close?)
    "UUID7.timestamp round-trips to within a second of now")
  (assert-equal test
    (UUID.hash &(init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    (UUID.hash &(init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    "equal UUIDs hash equally")
  (assert-true test (uuid-map-roundtrip?) "a UUID can be used as a Map key")
  (assert-equal test
    "00000000-0000-0000-0000-000000000000"
    &(str &(UUID.nil))
    "the Nil UUID stringifies to all zeroes")
  (assert-equal test
    "ffffffff-ffff-ffff-ffff-ffffffffffff"
    &(str &(UUID.max))
    "the Max UUID stringifies to all ffs")
  (assert-true test (UUID.nil? &(UUID.nil)) "nil? recognizes the Nil UUID")
  (assert-true test (UUID.max? &(UUID.max)) "max? recognizes the Max UUID")
  (assert-false test (UUID.nil? &(UUID.max)) "nil? rejects the Max UUID")
  (assert-false test (UUID.max? &(UUID.nil)) "max? rejects the Nil UUID")
  (assert-false test
    (UUID.nil? &(init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    "nil? rejects a non-zero UUID")
  (assert-false test
    (UUID.max? &(almost-max))
    "max? inspects every byte, not just a prefix")
  (assert-true test
    (UUID.< &(UUID.nil) &(UUID.max))
    "the Nil UUID sorts below the Max UUID")
  (assert-equal test
    &(Maybe.Just (UUID.nil))
    &(parse "00000000-0000-0000-0000-000000000000")
    "the Nil UUID round-trips through parse")
  (assert-equal test
    &(Maybe.Just (UUID.max))
    &(parse "ffffffff-ffff-ffff-ffff-ffffffffffff")
    "the Max UUID round-trips through parse")
  (assert-equal test &(UUID.nil) &(the UUID (zero)) "zero yields the Nil UUID")

  ; comparison operators, exercised against the Nil and Max extremes and a
  ; sample in between.
  (assert-true test
    (UUID.> &(UUID.max) &(UUID.nil))
    "> holds when the left UUID sorts after the right")
  (assert-true test
    (UUID.> &(sample) &(UUID.nil))
    "> holds against a non-extreme UUID")
  (assert-false test
    (UUID.> &(UUID.nil) &(UUID.max))
    "> rejects a UUID that sorts before")
  (assert-false test
    (UUID.> &(sample) &(sample))
    "> is strict, so equal UUIDs are not greater")
  (assert-true test
    (UUID.<= &(UUID.nil) &(UUID.max))
    "<= holds when the left UUID sorts before")
  (assert-true test (UUID.<= &(sample) &(sample)) "<= holds for equal UUIDs")
  (assert-false test
    (UUID.<= &(UUID.max) &(UUID.nil))
    "<= rejects a UUID that sorts after")
  (assert-true test
    (UUID.>= &(UUID.max) &(UUID.nil))
    ">= holds when the left UUID sorts after")
  (assert-true test (UUID.>= &(sample) &(sample)) ">= holds for equal UUIDs")
  (assert-false test
    (UUID.>= &(UUID.nil) &(UUID.max))
    ">= rejects a UUID that sorts before")
  (assert-equal test
    "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
    &(str &(UUID.namespace-dns))
    "the DNS namespace UUID matches RFC 9562 §6.6")
  (assert-equal test
    "6ba7b811-9dad-11d1-80b4-00c04fd430c8"
    &(str &(UUID.namespace-url))
    "the URL namespace UUID matches RFC 9562 §6.6")
  (assert-equal test
    "6ba7b812-9dad-11d1-80b4-00c04fd430c8"
    &(str &(UUID.namespace-oid))
    "the OID namespace UUID matches RFC 9562 §6.6")
  (assert-equal test
    "6ba7b814-9dad-11d1-80b4-00c04fd430c8"
    &(str &(UUID.namespace-x500))
    "the X.500 namespace UUID matches RFC 9562 §6.6")
  (assert-equal test
    5b
    (version &(UUID5.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID5.generate sets version 5")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID5.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID5.generate sets the RFC 4122 variant")
  (assert-equal test
    "2ed6657d-e927-568b-95e1-2665a8aea6a2"
    &(str &(UUID5.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID5.generate matches the DNS test vector")
  (assert-equal test
    "4ebd0208-8328-5d69-8c44-ec50939c0967"
    &(str &(UUID5.generate &(UUID.namespace-dns) ""))
    "UUID5.generate hashes the namespace alone for the empty name")
  (assert-equal test
    "582d4dda-0f76-5c7d-8ab4-35e0d74e5468"
    &(str &(UUID5.generate &(UUID.namespace-url) "https://carp-lang.org/"))
    "UUID5.generate matches the URL test vector")
  (assert-equal test
    "6aab0456-7392-582a-b92a-ba5a7096945d"
    &(str &(UUID5.generate &(UUID.namespace-oid) "1.3.6.1.4.1.343"))
    "UUID5.generate matches the OID test vector")
  (assert-equal test
    "e3280c80-707e-51d1-a888-11b8f0e0f0a7"
    &(str &(UUID5.generate &(UUID.namespace-x500) "CN=Veit,DC=example,DC=com"))
    "UUID5.generate matches the X.500 test vector")
  (assert-equal test
    "96c8a2e0-def7-5413-bf30-feab4a304528"
    &(str
      &(UUID5.generate &(UUID.namespace-dns) "grüße-über-straße.example"))
    "UUID5.generate hashes the UTF-8 bytes of a non-ASCII name")
  (assert-equal test
    "51440e97-37eb-5f30-9584-068bc66c16ed"
    &(str &(UUID5.generate &(UUID.nil) "nil-namespace"))
    "UUID5.generate accepts any UUID as a namespace")
  (assert-true test
    (v5-deterministic?)
    "UUID5.generate returns the same UUID for the same inputs")
  (assert-true test
    (v5-name-sensitive?)
    "UUID5.generate distinguishes names within a namespace")
  (assert-true test
    (v5-namespace-sensitive?)
    "UUID5.generate distinguishes namespaces for the same name")
  (assert-equal test
    "2f80c0d1-1c62-579f-8d68-e61ad5592c9b"
    &(v5-x 39)
    "UUID5.generate pads a 55-byte hash input")
  (assert-equal test
    "e56fd57a-7633-5e1d-8f80-70e05ac413e5"
    &(v5-x 40)
    "UUID5.generate spills a 56-byte hash input into a second block")
  (assert-equal test
    "a112377b-8258-5ef7-b5b0-d2540bc03abb"
    &(v5-x 47)
    "UUID5.generate pads a 63-byte hash input")
  (assert-equal test
    "83993b6c-dea9-55ca-be5b-9989c85943fc"
    &(v5-x 48)
    "UUID5.generate pads a block-aligned 64-byte hash input")
  (assert-equal test
    "69b5a616-6ae8-5c37-8b46-37d527314c4d"
    &(v5-x 103)
    "UUID5.generate pads a 119-byte hash input")
  (assert-equal test
    "c917ca2c-8395-5e00-8f28-a898d41a4b8d"
    &(v5-x 104)
    "UUID5.generate spills a 120-byte hash input into a third block"))
