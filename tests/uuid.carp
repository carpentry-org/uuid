(load "uuid.carp")

(load "Test.carp")

(use-all Test UUID)

; generate two v7 UUIDs in sequence and check they sort in creation order. The
; binding order matters, so this cannot be inlined as two argument expressions.
(defn v7-monotonic? []
  (let-do [u1 (UUID7.generate)
           u2 (UUID7.generate)] (UUID.< &u1 &u2)))

; |a - b| < limit, subtracting in the larger direction to avoid Uint64 underflow.
(defn within? [a b limit]
  (if (Uint64.> a b)
    (Uint64.< (Uint64.- a b) limit)
    (Uint64.< (Uint64.- b a) limit)))

(defn two-seconds-ns [] (Uint64.from-long 2000000000l))

; the timestamp read back out of a fresh v7 UUID should be within ~2s of now.
(defn v7-timestamp-close? []
  (let [u (UUID7.generate)]
    (within? (UUID7.timestamp &u)
             (Uint64./ (System.nanotime) (Uint64.from-long 1000000l))
             (Uint64.from-long 2000l))))

; a UUID must be usable as a Map key, which requires a hash implementation.
(defn uuid-map-roundtrip? []
  (let [u (init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b])
        m (Map.put (Map.create) &u &42)]
    (= &(Maybe.Just 42) &(Map.get-maybe &m &u))))

; the Max UUID with only its final byte cleared, so max? must inspect every
; byte rather than short-circuiting before the end.
(defn almost-max []
  (let-do [a @(UUID.internal &(UUID.max))] (Array.aset! &a 15 0b) (UUID.init a)))

; an arbitrary UUID that sits strictly between the Nil and Max extremes.
(defn sample []
  (UUID.init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))

; random-node v1 UUIDs set the multicast bit: LSB of byte 10 (RFC 4122 §4.5)
(defn v1-multicast-bit-set? []
  (let [u (UUID1.generate)
        a (UUID.internal &u)]
    (Byte.= 1b (Byte.bit-and @(Array.unsafe-nth a 10) 1b))))

; version nibble (high 4 bits of byte 6) is 1 for v1
(defn v1-version-nibble? []
  (let [u (UUID1.generate)
        a (UUID.internal &u)]
    (Byte.= 1b (Byte.bit-shift-right @(Array.unsafe-nth a 6) 4b))))

; variant bits (top 2 bits of byte 8) are 10 for RFC 4122
(defn v1-variant-bits? []
  (let [u (UUID1.generate)
        a (UUID.internal &u)]
    (Byte.= 128b (Byte.bit-and @(Array.unsafe-nth a 8) 192b))))

(defn mask60 []
  (Uint64.-
    (Uint64.bit-shift-left (Uint64.from-long 1l) (Uint64.from-long 60l))
    (Uint64.from-long 1l)))

; the 60-bit timestamp of a v1 UUID, i.e. time_low, time_mid and
; time_hi_and_version with the version nibble masked off.
(defn v1-timestamp [u]
  (let-do [a (UUID.internal u)
           order [6 7 4 5 0 1 2 3]
           ts (Uint64.zero)]
    (for [i 0 8]
      (set! ts
            (Uint64.bit-or
              (Uint64.bit-shift-left ts (Uint64.from-long 8l))
              (Uint64.from-long
                (Long.from-int
                  (Byte.to-int
                    @(Array.unsafe-nth a @(Array.unsafe-nth &order i))))))))
    (Uint64.bit-and ts (mask60))))

; the version-1 timestamp of the Unix epoch, and the clock on the scale
; RFC 9562 §5.1 defines for versions 1 and 6 — both recomputed here so the
; assertions never check the library against itself.
(defn unix-epoch-ticks []
  (Uint64.* (Uint64.from-long 122192928l) (Uint64.from-long 1000000000l)))

(defn rfc-now []
  (Uint64.+
    (Uint64./ (System.nanotime) (Uint64.from-long 100l))
    (unix-epoch-ticks)))

; two seconds, in the 100-nanosecond ticks a v1 or v6 timestamp counts.
(defn two-seconds-ticks [] (Uint64.from-long 20000000l))

(defn v1-timestamp-tracks-clock? []
  (let [u (UUID1.generate)]
    (within? (v1-timestamp &u) (rfc-now) (two-seconds-ticks))))

(defn v1-timestamp-matches-fields? []
  (let [u (UUID1.generate)] (Uint64.= (UUID1.timestamp &u) (v1-timestamp &u))))

; what an external reader gets: the timestamp put back on the Unix scale.
(defn v1-decodes-to-now? []
  (let [u (UUID1.generate)]
    (within?
      (Maybe.or-zero (UUID1.to-nanotime (UUID1.timestamp &u)))
      (System.nanotime)
      (two-seconds-ns))))

; two UUIDs generated inside one 100-nanosecond tick must still differ in time.
(defn v1-timestamps-increase? []
  (let-do [u1 (UUID1.generate)
           u2 (UUID1.generate)]
    (Uint64.> (UUID1.timestamp &u2) (UUID1.timestamp &u1))))

; the version-1 clock state, driven by synthetic readings: two real reads never
; land inside one 100-nanosecond tick.
(defmodule UUID1
  (defn replay [readings]
    (let-do [out (Array.copy readings)]
      (set! slast (Uint64.zero))
      (set! adjustment 0)
      (for [i 0 (Array.length readings)]
        (do
          (ignore (advance @(Array.unsafe-nth readings i)))
          (Array.aset! &out i (emitted))))
      out))

  (defn tick [now] (do (ignore (advance now)) (emitted)))

  (defn stalled? [now] (not (advance now))))

; a synthetic clock reading below the real clock, built as a product of two
; sub-2^31 values because a 32-bit build folds a Long literal this large.
(defn tick-base []
  (Uint64.* (Uint64.from-long 130000000l) (Uint64.from-long 1000000000l)))

(defn ticks-in [n] (Uint64.+ (tick-base) (Uint64.from-long (Long.from-int n))))

(defn increasing? [xs]
  (let-do [ok true]
    (for [i 1 (Array.length xs)]
      (unless (Uint64.< @(Array.unsafe-nth xs (Int.- i 1))
                        @(Array.unsafe-nth xs i))
        (set! ok false)))
    ok))

; three readings inside one tick, then the tick the burst has already reached.
(defn tie-readings [] [(ticks-in 0) (ticks-in 0) (ticks-in 0) (ticks-in 1)])

(defn ties-increase? [] (increasing? &(UUID1.replay &(tie-readings))))

(defn ties-keep-clock-seq? []
  (let-do [before 0]
    (UUID1.set-clock-seq -1)
    (set! before UUID1.clock-seq)
    (ignore (UUID1.replay &(tie-readings)))
    (Int.= before UUID1.clock-seq)))

; ties, then a reading that genuinely steps backwards, then the tick after it.
(defn backwards-readings []
  [(ticks-in 4) (ticks-in 4) (ticks-in 4) (ticks-in 2) (ticks-in 3)])

(defn backwards-bumps-clock-seq? []
  (let-do [before 0]
    (UUID1.set-clock-seq -1)
    (set! before UUID1.clock-seq)
    (ignore (UUID1.replay &(backwards-readings)))
    (Int./= before UUID1.clock-seq)))

(defn backwards-clears-adjustment? []
  (Uint64.=
    @(Array.unsafe-nth &(UUID1.replay &(backwards-readings)) 4)
    (ticks-in 3)))

; ties, then a reading well past them, then a tie at that new reading.
(defn forward-readings []
  [(ticks-in 0) (ticks-in 0) (ticks-in 0) (ticks-in 100) (ticks-in 100)])

(defn forward-clears-adjustment? []
  (Uint64.=
    @(Array.unsafe-nth &(UUID1.replay &(forward-readings)) 4)
    (ticks-in 101)))

; one forward reading and nine ties exhaust the adjustment; the tenth tie waits.
(defn stalls-at-cap? []
  (do
    (ignore (UUID1.replay &(Array.replicate 10 &(tick-base))))
    (UUID1.stalled? (tick-base))))

(defn recovers-after-stall? []
  (let [stalled (stalls-at-cap?)]
    (and stalled (Uint64.= (UUID1.tick (ticks-in 10)) (ticks-in 10)))))

(defn clock-above-32-bits []
  (Uint64.bit-shift-right (rfc-now) (Uint64.from-long 32l)))

; time_mid and time_hi must hold bits 32-59 of the clock. Reading those bits on
; both sides of the call covers a carry into bit 32 landing mid-test.
(defn v1-high-bits-match-clock? []
  (let [before (clock-above-32-bits)
        u (UUID1.generate)
        after (clock-above-32-bits)
        high (Uint64.bit-shift-right (v1-timestamp &u) (Uint64.from-long 32l))]
    (or (Uint64.= high before) (Uint64.= high after))))

(defn parsed [s] (Maybe.from (UUID.parse s) (UUID.nil)))

; RFC 9562’s version-1 and version-6 test vectors: one UUID in both layouts.
(defn v1-vector [] (parsed "c232ab00-9414-11ec-b3c8-9f6bdeced846"))

(defn v6-vector [] (parsed "1ec9414c-232a-6b00-b3c8-9f6bdeced846"))

; both vectors carry 2022-02-22 19:22:22 UTC, i.e. 1645557742 Unix seconds.
(defn vector-nanotime []
  (Uint64.* (Uint64.from-long 1645557742l) (Uint64.from-long 1000000000l)))

(defn v6-monotonic? []
  (let-do [u1 (UUID6.generate)
           u2 (UUID6.generate)] (UUID.< &u1 &u2)))

(defn v6-decodes-to-now? []
  (let [u (UUID6.generate)]
    (within?
      (Maybe.or-zero (UUID1.to-nanotime (UUID6.timestamp &u)))
      (System.nanotime)
      (two-seconds-ns))))

(defn v6-roundtrips? []
  (let [u (UUID1.generate)] (UUID.= &u &(UUID6.to-v1 &(UUID6.from-v1 &u)))))

; a v5 UUID over a name of `n` `x`es. With the 16-byte namespace prepended this
; puts the SHA-1 input at 16+n bytes, pinning the padding boundaries.
(defn v5-x [n]
  (UUID.str &(UUID5.generate &(UUID.namespace-dns) &(String.repeat n "x"))))

(defn v5-deterministic? []
  (UUID.=
    &(UUID5.generate &(UUID.namespace-url) "https://carp-lang.org/")
    &(UUID5.generate &(UUID.namespace-url) "https://carp-lang.org/")))

(defn v5-name-sensitive? []
  (UUID./=
    &(UUID5.generate &(UUID.namespace-dns) "a")
    &(UUID5.generate &(UUID.namespace-dns) "b")))

(defn v5-namespace-sensitive? []
  (UUID./=
    &(UUID5.generate &(UUID.namespace-dns) "www.example.com")
    &(UUID5.generate &(UUID.namespace-url) "www.example.com")))

; a v3 UUID over a name of `n` `x`es. With the 16-byte namespace prepended this
; puts the MD5 input at 16+n bytes, pinning the padding boundaries.
(defn v3-x [n]
  (UUID.str &(UUID3.generate &(UUID.namespace-dns) &(String.repeat n "x"))))

(defn v3-deterministic? []
  (UUID.=
    &(UUID3.generate &(UUID.namespace-url) "https://carp-lang.org/")
    &(UUID3.generate &(UUID.namespace-url) "https://carp-lang.org/")))

(defn v3-name-sensitive? []
  (UUID./=
    &(UUID3.generate &(UUID.namespace-dns) "a")
    &(UUID3.generate &(UUID.namespace-dns) "b")))

(defn v3-namespace-sensitive? []
  (UUID./=
    &(UUID3.generate &(UUID.namespace-dns) "www.example.com")
    &(UUID3.generate &(UUID.namespace-url) "www.example.com")))

(defn v3-differs-from-v5? []
  (UUID./=
    &(UUID3.generate &(UUID.namespace-dns) "www.example.com")
    &(UUID5.generate &(UUID.namespace-dns) "www.example.com")))

(deftest test
  (assert-equal test
    "00010203-0405-0607-0809-0a0b0c0d0e0f"
    &(str &(init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    "stringification works")
  (assert-equal test 4b (version &(UUID4.generate)) "UUID4.generate works I")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID4.generate))
    "UUID4.generate works II")
  (assert-equal test 1b (version &(UUID1.generate)) "UUID1.generate works I")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID1.generate))
    "UUID1.generate works II")
  (assert-true test
    (v1-multicast-bit-set?)
    "UUID1.generate sets the RFC 4122 multicast bit on the node")
  (assert-true test
    (v1-version-nibble?)
    "UUID1.generate sets version 1 in the byte-6 nibble")
  (assert-true test
    (v1-variant-bits?)
    "UUID1.generate sets the RFC 4122 variant bits in byte 8")
  (assert-true test
    (v1-timestamp-tracks-clock?)
    "UUID1.generate stamps the current time into the timestamp fields")
  (assert-true test
    (v1-high-bits-match-clock?)
    "UUID1.generate fills time_mid and time_hi from the clock")
  (assert-true test
    (v1-timestamp-matches-fields?)
    "UUID1.timestamp reads back the raw timestamp fields")
  (assert-true test
    (v1-decodes-to-now?)
    "a v1 timestamp decodes to the current time on the Unix scale")
  (assert-true test
    (v1-timestamps-increase?)
    "successive UUID1.generate timestamps strictly increase")
  (assert-true test
    (ties-increase?)
    "readings inside one tick still give strictly increasing timestamps")
  (assert-true test
    (ties-keep-clock-seq?)
    "readings inside one tick leave the clock sequence alone")
  (assert-true test
    (backwards-bumps-clock-seq?)
    "a clock stepping backwards bumps the clock sequence")
  (assert-true test
    (forward-clears-adjustment?)
    "a real forward step clears the ticks the ties ran ahead")
  (assert-true test
    (backwards-clears-adjustment?)
    "a clock stepping backwards clears the ticks the ties ran ahead")
  (assert-true test
    (recovers-after-stall?)
    "the generator stops nine ticks ahead of the clock, then resumes")
  (assert-equal test
    &(Maybe.Just (Uint64.zero))
    &(UUID1.to-nanotime (unix-epoch-ticks))
    "the Unix epoch converts to nanotime zero")
  (assert-equal test
    &(Maybe.Nothing)
    &(UUID1.to-nanotime (Uint64.- (unix-epoch-ticks) (Uint64.from-long 1l)))
    "a timestamp before the Unix epoch has no nanotime")
  (assert-equal test
    &(Maybe.Just (vector-nanotime))
    &(UUID1.to-nanotime (UUID1.timestamp &(v1-vector)))
    "UUID1.timestamp decodes the RFC 9562 version-1 test vector")
  (assert-equal test
    &(Maybe.Just (init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    &(parse "00010203-0405-0607-0809-0a0b0c0d0e0f")
    "parsing works I")
  (assert-equal test &(Maybe.Nothing) &(parse "invalid hex") "parsing works II")
  (assert-false test
    (valid? "prefix00000000-0000-0000-0000-000000000000")
    "prefixed UUID is rejected")
  (assert-false test
    (valid? "00000000-0000-0000-0000-000000000000suffix")
    "suffixed UUID is rejected")
  (assert-equal test
    7b
    (version &(UUID7.generate))
    "UUID7.generate sets version 7")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID7.generate))
    "UUID7.generate sets the RFC 4122 variant")
  (assert-true test
    (valid? &(str &(UUID7.generate)))
    "UUID7.generate produces a structurally valid UUID")
  (assert-true test
    (v7-monotonic?)
    "successive UUID7.generate results are strictly ordered")
  (assert-true test
    (v7-timestamp-close?)
    "UUID7.timestamp round-trips to within a second of now")
  (assert-equal test
    6b
    (version &(UUID6.generate))
    "UUID6.generate sets version 6")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID6.generate))
    "UUID6.generate sets the RFC 4122 variant")
  (assert-true test
    (valid? &(str &(UUID6.generate)))
    "UUID6.generate produces a structurally valid UUID")
  (assert-true test
    (v6-monotonic?)
    "successive UUID6.generate results are strictly ordered")
  (assert-true test
    (v6-decodes-to-now?)
    "a v6 timestamp decodes to the current time on the Unix scale")
  (assert-equal test
    "1ec9414c-232a-6b00-b3c8-9f6bdeced846"
    &(str &(UUID6.from-v1 &(v1-vector)))
    "UUID6.from-v1 matches the RFC 9562 version-6 test vector")
  (assert-equal test
    "c232ab00-9414-11ec-b3c8-9f6bdeced846"
    &(str &(UUID6.to-v1 &(v6-vector)))
    "UUID6.to-v1 inverts the layout on the RFC 9562 test vectors")
  (assert-equal test
    &(Maybe.Just (vector-nanotime))
    &(UUID1.to-nanotime (UUID6.timestamp &(v6-vector)))
    "UUID6.timestamp decodes the RFC 9562 version-6 test vector")
  (assert-true test
    (v6-roundtrips?)
    "from-v1 and to-v1 round-trip a generated UUID")
  (assert-equal test
    (UUID.hash &(init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    (UUID.hash &(init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    "equal UUIDs hash equally")
  (assert-true test (uuid-map-roundtrip?) "a UUID can be used as a Map key")
  (assert-equal test
    "00000000-0000-0000-0000-000000000000"
    &(str &(UUID.nil))
    "the Nil UUID stringifies to all zeroes")
  (assert-equal test
    "ffffffff-ffff-ffff-ffff-ffffffffffff"
    &(str &(UUID.max))
    "the Max UUID stringifies to all ffs")
  (assert-true test (UUID.nil? &(UUID.nil)) "nil? recognizes the Nil UUID")
  (assert-true test (UUID.max? &(UUID.max)) "max? recognizes the Max UUID")
  (assert-false test (UUID.nil? &(UUID.max)) "nil? rejects the Max UUID")
  (assert-false test (UUID.max? &(UUID.nil)) "max? rejects the Nil UUID")
  (assert-false test
    (UUID.nil? &(init [0b 1b 2b 3b 4b 5b 6b 7b 8b 9b 10b 11b 12b 13b 14b 15b]))
    "nil? rejects a non-zero UUID")
  (assert-false test
    (UUID.max? &(almost-max))
    "max? inspects every byte, not just a prefix")
  (assert-true test
    (UUID.< &(UUID.nil) &(UUID.max))
    "the Nil UUID sorts below the Max UUID")
  (assert-equal test
    &(Maybe.Just (UUID.nil))
    &(parse "00000000-0000-0000-0000-000000000000")
    "the Nil UUID round-trips through parse")
  (assert-equal test
    &(Maybe.Just (UUID.max))
    &(parse "ffffffff-ffff-ffff-ffff-ffffffffffff")
    "the Max UUID round-trips through parse")
  (assert-equal test &(UUID.nil) &(the UUID (zero)) "zero yields the Nil UUID")

  ; comparison operators, exercised against the Nil and Max extremes and a
  ; sample in between.
  (assert-true test
    (UUID.> &(UUID.max) &(UUID.nil))
    "> holds when the left UUID sorts after the right")
  (assert-true test
    (UUID.> &(sample) &(UUID.nil))
    "> holds against a non-extreme UUID")
  (assert-false test
    (UUID.> &(UUID.nil) &(UUID.max))
    "> rejects a UUID that sorts before")
  (assert-false test
    (UUID.> &(sample) &(sample))
    "> is strict, so equal UUIDs are not greater")
  (assert-true test
    (UUID.<= &(UUID.nil) &(UUID.max))
    "<= holds when the left UUID sorts before")
  (assert-true test (UUID.<= &(sample) &(sample)) "<= holds for equal UUIDs")
  (assert-false test
    (UUID.<= &(UUID.max) &(UUID.nil))
    "<= rejects a UUID that sorts after")
  (assert-true test
    (UUID.>= &(UUID.max) &(UUID.nil))
    ">= holds when the left UUID sorts after")
  (assert-true test (UUID.>= &(sample) &(sample)) ">= holds for equal UUIDs")
  (assert-false test
    (UUID.>= &(UUID.nil) &(UUID.max))
    ">= rejects a UUID that sorts before")
  (assert-equal test
    "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
    &(str &(UUID.namespace-dns))
    "the DNS namespace UUID matches RFC 9562 §6.6")
  (assert-equal test
    "6ba7b811-9dad-11d1-80b4-00c04fd430c8"
    &(str &(UUID.namespace-url))
    "the URL namespace UUID matches RFC 9562 §6.6")
  (assert-equal test
    "6ba7b812-9dad-11d1-80b4-00c04fd430c8"
    &(str &(UUID.namespace-oid))
    "the OID namespace UUID matches RFC 9562 §6.6")
  (assert-equal test
    "6ba7b814-9dad-11d1-80b4-00c04fd430c8"
    &(str &(UUID.namespace-x500))
    "the X.500 namespace UUID matches RFC 9562 §6.6")
  (assert-equal test
    5b
    (version &(UUID5.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID5.generate sets version 5")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID5.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID5.generate sets the RFC 4122 variant")
  (assert-equal test
    "2ed6657d-e927-568b-95e1-2665a8aea6a2"
    &(str &(UUID5.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID5.generate matches the DNS test vector")
  (assert-equal test
    "4ebd0208-8328-5d69-8c44-ec50939c0967"
    &(str &(UUID5.generate &(UUID.namespace-dns) ""))
    "UUID5.generate hashes the namespace alone for the empty name")
  (assert-equal test
    "582d4dda-0f76-5c7d-8ab4-35e0d74e5468"
    &(str &(UUID5.generate &(UUID.namespace-url) "https://carp-lang.org/"))
    "UUID5.generate matches the URL test vector")
  (assert-equal test
    "6aab0456-7392-582a-b92a-ba5a7096945d"
    &(str &(UUID5.generate &(UUID.namespace-oid) "1.3.6.1.4.1.343"))
    "UUID5.generate matches the OID test vector")
  (assert-equal test
    "e3280c80-707e-51d1-a888-11b8f0e0f0a7"
    &(str &(UUID5.generate &(UUID.namespace-x500) "CN=Veit,DC=example,DC=com"))
    "UUID5.generate matches the X.500 test vector")
  (assert-equal test
    "96c8a2e0-def7-5413-bf30-feab4a304528"
    &(str
      &(UUID5.generate &(UUID.namespace-dns) "grüße-über-straße.example"))
    "UUID5.generate hashes the UTF-8 bytes of a non-ASCII name")
  (assert-equal test
    "51440e97-37eb-5f30-9584-068bc66c16ed"
    &(str &(UUID5.generate &(UUID.nil) "nil-namespace"))
    "UUID5.generate accepts any UUID as a namespace")
  (assert-true test
    (v5-deterministic?)
    "UUID5.generate returns the same UUID for the same inputs")
  (assert-true test
    (v5-name-sensitive?)
    "UUID5.generate distinguishes names within a namespace")
  (assert-true test
    (v5-namespace-sensitive?)
    "UUID5.generate distinguishes namespaces for the same name")
  (assert-equal test
    "2f80c0d1-1c62-579f-8d68-e61ad5592c9b"
    &(v5-x 39)
    "UUID5.generate pads a 55-byte hash input")
  (assert-equal test
    "e56fd57a-7633-5e1d-8f80-70e05ac413e5"
    &(v5-x 40)
    "UUID5.generate spills a 56-byte hash input into a second block")
  (assert-equal test
    "a112377b-8258-5ef7-b5b0-d2540bc03abb"
    &(v5-x 47)
    "UUID5.generate pads a 63-byte hash input")
  (assert-equal test
    "83993b6c-dea9-55ca-be5b-9989c85943fc"
    &(v5-x 48)
    "UUID5.generate pads a block-aligned 64-byte hash input")
  (assert-equal test
    "69b5a616-6ae8-5c37-8b46-37d527314c4d"
    &(v5-x 103)
    "UUID5.generate pads a 119-byte hash input")
  (assert-equal test
    "c917ca2c-8395-5e00-8f28-a898d41a4b8d"
    &(v5-x 104)
    "UUID5.generate spills a 120-byte hash input into a third block")
  (assert-equal test
    3b
    (version &(UUID3.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID3.generate sets version 3")
  (assert-equal test
    UUID.rfc4122
    (variant &(UUID3.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID3.generate sets the RFC 4122 variant")
  (assert-equal test
    "5df41881-3aed-3515-88a7-2f4a814cf09e"
    &(str &(UUID3.generate &(UUID.namespace-dns) "www.example.com"))
    "UUID3.generate matches the DNS test vector")
  (assert-equal test
    "c87ee674-4ddc-3efe-a74e-dfe25da5d7b3"
    &(str &(UUID3.generate &(UUID.namespace-dns) ""))
    "UUID3.generate hashes the namespace alone for the empty name")
  (assert-equal test
    "b5d3e9ab-2f60-3ab1-af89-c003cbba4a7f"
    &(str &(UUID3.generate &(UUID.namespace-url) "https://carp-lang.org/"))
    "UUID3.generate matches the URL test vector")
  (assert-equal test
    "77bc1dc3-0a9f-3e7e-bfa5-3f611a660c80"
    &(str &(UUID3.generate &(UUID.namespace-oid) "1.3.6.1.4.1.343"))
    "UUID3.generate matches the OID test vector")
  (assert-equal test
    "152ca505-f847-3b8b-8078-77da6dcbcd25"
    &(str &(UUID3.generate &(UUID.namespace-x500) "CN=Veit,DC=example,DC=com"))
    "UUID3.generate matches the X.500 test vector")
  (assert-equal test
    "f4591ad1-d71b-318b-ad27-0516e4430048"
    &(str
      &(UUID3.generate &(UUID.namespace-dns) "grüße-über-straße.example"))
    "UUID3.generate hashes the UTF-8 bytes of a non-ASCII name")
  (assert-equal test
    "091d2ec8-a4c8-3c71-8da2-006081c6070d"
    &(str &(UUID3.generate &(UUID.nil) "nil-namespace"))
    "UUID3.generate accepts any UUID as a namespace")
  (assert-true test
    (v3-deterministic?)
    "UUID3.generate returns the same UUID for the same inputs")
  (assert-true test
    (v3-name-sensitive?)
    "UUID3.generate distinguishes names within a namespace")
  (assert-true test
    (v3-namespace-sensitive?)
    "UUID3.generate distinguishes namespaces for the same name")
  (assert-true test
    (v3-differs-from-v5?)
    "UUID3.generate hashes with MD5, not SHA-1")
  (assert-equal test
    "9d902192-c4ec-3728-9fea-143008550e51"
    &(v3-x 39)
    "UUID3.generate pads a 55-byte hash input")
  (assert-equal test
    "86fe7d7e-7301-3ac7-88ce-33c35da4750e"
    &(v3-x 40)
    "UUID3.generate spills a 56-byte hash input into a second block")
  (assert-equal test
    "81ac6b83-b9ae-3c53-b70d-5ffe073dd680"
    &(v3-x 47)
    "UUID3.generate pads a 63-byte hash input")
  (assert-equal test
    "0ab17325-9505-3328-9d17-eff4a7e95f21"
    &(v3-x 48)
    "UUID3.generate pads a block-aligned 64-byte hash input")
  (assert-equal test
    "4ecd45a3-43b8-3e2b-a61e-1cfffdc0c518"
    &(v3-x 103)
    "UUID3.generate pads a 119-byte hash input")
  (assert-equal test
    "b8a61313-7683-3917-8433-6a4fb82ab9b9"
    &(v3-x 104)
    "UUID3.generate spills a 120-byte hash input into a third block"))
